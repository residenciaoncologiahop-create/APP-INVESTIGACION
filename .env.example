# Opcional: configurar GEMINI_API_KEY en el servidor local o en Vercel Preview.
# Alternativamente, cada investigador puede ingresar su propia API Key (BYOK) desde la interfaz (guardada en IndexedDB local).
GEMINI_API_KEY=

# Seguridad para Vercel Preview (recomendado si se configura GEMINI_API_KEY en servidor):
# Autenticación HTTP Basic / Bearer a nivel de aplicación (middleware + endpoints /api/*).
PREVIEW_AUTH_USER=researcher
PREVIEW_AUTH_PASSWORD=

# Solo si NO se usa PREVIEW_AUTH_PASSWORD en Vercel y ya se verificó que Vercel Deployment Protection
# (Vercel Authentication o Password Protection) está habilitado en el panel de Vercel:
# VERCEL_DEPLOYMENT_PROTECTION_CONFIRMED=true

# Opcional: lista separada por comas de modelos Gemini permitidos (sobreescribe la allowlist por defecto).
# GEMINI_ALLOWED_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.5-pro

# Opcional: orígenes adicionales permitidos (separados por coma), ej. https://mi-dominio.vercel.app
# ALLOWED_ORIGINS=
